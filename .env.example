# ==========================================
# AMS AI Backend Configuration
# ==========================================

# AMS API Credentials
AMS_EMAIL=your_email@domain.com
AMS_PASSWORD=your_password

# AMS API Endpoints
AMS_AUTH_URL=http://172.16.32.50/api/Auth/login
AMS_TICKET_URL=http://172.16.32.50/api/Ticket
AMS_TICKET_STATUS_URL=http://172.16.32.50/api/Ticket/Status
AMS_TICKET_CREATE_URL=http://172.16.32.50/api/Ticket/CreateTicket

# Google Gemini API Key (Required for dynamic AI query reasoning & ticket classification)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
